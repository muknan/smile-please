NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your-brevo-login
SMTP_PASS=your-brevo-smtp-key
MAIL_FROM="Smile Please <noreply@example.com>"
# Set to 1 only when SMTP_* are real and mail should be sent (D-42).
SMTP_ENABLED=0
ADMIN_NOTIFY_EMAIL=admin@example.com
CRON_SECRET=generate-a-random-string
FORM_SECRET=generate-a-different-random-string
# WhatsApp deep-link number (digits only, with country code, e.g. 919876543210).
# Leave empty to hide the WhatsApp button on /contact.
NEXT_PUBLIC_WHATSAPP_NUMBER=
